generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  email              String              @unique
  passwordHash       String
  isActive           Boolean             @default(true)
  roleId             String              @db.Uuid
  role               Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ownedProjects      Project[]           @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  projectInvitations ProjectInvitation[] @relation("InvitedUser")
  proposals          UmlProposal[]

  @@index([roleId])
}

model Project {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  description String?
  ownerId     String              @db.Uuid
  owner       User                @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  invitations ProjectInvitation[]
  diagrams    Diagram[]
  proposals   UmlProposal[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  @@index([ownerId])
  @@index([deletedAt])
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  userId    String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectInvitation {
  id            String           @id @default(uuid()) @db.Uuid
  projectId     String           @db.Uuid
  invitedUserId String           @db.Uuid
  tokenHash     String           @unique
  status        InvitationStatus @default(PENDING)
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  acceptedAt    DateTime?
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedUser   User             @relation("InvitedUser", fields: [invitedUserId], references: [id], onDelete: Restrict)

  @@index([projectId, status])
  @@index([invitedUserId, status])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum UmlVisibility {
  PUBLIC
  PRIVATE
  PROTECTED
  PACKAGE
}

enum UmlRelationType {
  ASSOCIATION
  AGGREGATION
  COMPOSITION
  INHERITANCE
  DEPENDENCY
}

model Diagram {
  id        String        @id @default(uuid()) @db.Uuid
  projectId String        @unique @db.Uuid
  name      String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  classes   UmlClass[]
  relations UmlRelation[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model UmlClass {
  id              String         @id @default(uuid()) @db.Uuid
  diagramId       String         @db.Uuid
  name            String
  x               Float
  y               Float
  width           Float?
  height          Float?
  isAbstract      Boolean        @default(false)
  diagram         Diagram        @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  attributes      UmlAttribute[]
  methods         UmlMethod[]
  sourceRelations UmlRelation[]  @relation("RelationSource")
  targetRelations UmlRelation[]  @relation("RelationTarget")
  associationClassRelation UmlRelation? @relation("AssociationClass")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([diagramId])
}

model UmlAttribute {
  id           String        @id @default(uuid()) @db.Uuid
  umlClassId   String        @db.Uuid
  name         String
  type         String
  visibility   UmlVisibility @default(PRIVATE)
  isPrimaryKey Boolean       @default(false)
  position     Int           @default(0)
  umlClass     UmlClass      @relation(fields: [umlClassId], references: [id], onDelete: Cascade)

  @@index([umlClassId, position])
}

model UmlMethod {
  id         String        @id @default(uuid()) @db.Uuid
  umlClassId String        @db.Uuid
  name       String
  returnType String
  visibility UmlVisibility @default(PUBLIC)
  position   Int           @default(0)
  umlClass   UmlClass      @relation(fields: [umlClassId], references: [id], onDelete: Cascade)

  @@index([umlClassId, position])
}

model UmlRelation {
  id                 String          @id @default(uuid()) @db.Uuid
  diagramId          String          @db.Uuid
  sourceClassId      String          @db.Uuid
  targetClassId      String          @db.Uuid
  associationClassId String?         @unique @db.Uuid
  type               UmlRelationType
  sourceMultiplicity String          @default("1")
  targetMultiplicity String          @default("1")
  label              String?
  diagram            Diagram         @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  sourceClass        UmlClass        @relation("RelationSource", fields: [sourceClassId], references: [id], onDelete: Restrict)
  targetClass        UmlClass        @relation("RelationTarget", fields: [targetClassId], references: [id], onDelete: Restrict)
  associationClass   UmlClass?       @relation("AssociationClass", fields: [associationClassId], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([diagramId])
  @@index([sourceClassId])
  @@index([targetClassId])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ProposalStatus {
  PENDING
  APPLIED
  REJECTED
  ERROR
}

enum ProposalOrigin {
  MOBILE_IMAGE
  WEB_AI
}

model UmlProposal {
  id              String         @id @default(uuid()) @db.Uuid
  projectId       String         @db.Uuid
  userId          String         @db.Uuid
  origin          ProposalOrigin @default(MOBILE_IMAGE)
  status          ProposalStatus @default(PENDING)
  prompt          String?
  summary         String?
  classesCount    Int            @default(0)
  attributesCount Int            @default(0)
  methodsCount    Int            @default(0)
  relationsCount  Int            @default(0)
  proposalJson    Json
  errorMessage    String?
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([projectId, status])
  @@index([userId])
}
