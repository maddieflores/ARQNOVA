PORT=3000
# En producción: https://arqnova-demo.duckdns.org
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://arqnova:change_me_local_only@localhost:5433/arqnova?schema=public
# Generar localmente un secreto aleatorio de al menos 32 caracteres.
JWT_SECRET=
# Duración en segundos.
JWT_EXPIRES_IN=3600
# Solo para seed de desarrollo. Nunca versionar la contraseña real.
ADMIN_NAME=Administrador de desarrollo
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=
# Guardia adicional requerida exclusivamente por el bootstrap controlado de producción.
ADMIN_BOOTSTRAP_ENABLED=false
# Proveedor disponible en Fase 4A: mock. Las claves reales permanecen fuera de Git.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=10000
# Opcional: ruta o nombre del ejecutable Maven usado para validar el backend generado.
MAVEN_COMMAND=mvn
# Opcional: caché de dependencias Maven. Si se omite usa el directorio temporal.
MAVEN_REPOSITORY=
